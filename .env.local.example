# Copy this file to .env.local for local development. Never commit .env.local.
# These are server-only settings. Replace blank values with the provider's real
# API base URL, key and model ID; then restart Next.js.
# Direct Image/Video Generation skills do not require the text provider.
# See docs/generation-providers.md for exact JSON request/response contracts.

# Image provider. Default: POST {BASE_URL}/images/generations with JSON
# model, prompt, n, size, aspect_ratio and resolution. With references it also
# sends images and image. Default response: {"data":[{"url":"https://..."}]} or
# {"data":[{"b64_json":"PNG_BASE64"}]}.
SPARKLE_IMAGE_BASE_URL=
SPARKLE_IMAGE_API_KEY=
SPARKLE_IMAGE_MODEL=
SPARKLE_IMAGE_MODELS=
# Uncomment and adapt these only when the provider differs from the defaults.
# SPARKLE_IMAGE_ENDPOINT=/images/generations
# SPARKLE_IMAGE_REQUEST_TEMPLATE='{"model":"{{model}}","prompt":"{{prompt}}","n":"{{count}}","size":"{{size}}"}'
# SPARKLE_IMAGE_OUTPUT_PATH=data
# SPARKLE_IMAGE_URL_PATH=url
# SPARKLE_IMAGE_B64_PATH=b64_json
# SPARKLE_IMAGE_AUTH_HEADER=Authorization
# SPARKLE_IMAGE_AUTH_SCHEME=Bearer

# Video provider. Default: POST {BASE_URL}/videos with JSON model, prompt, n,
# aspect_ratio, resolution, duration, images and videos. It may return a URL
# immediately, or an ID for polling at GET {BASE_URL}/videos/{{jobId}}.
SPARKLE_VIDEO_BASE_URL=
SPARKLE_VIDEO_API_KEY=
SPARKLE_VIDEO_MODEL=
SPARKLE_VIDEO_MODELS=
# Uncomment and adapt these to the chosen provider's actual protocol.
# SPARKLE_VIDEO_ENDPOINT=/videos
# SPARKLE_VIDEO_REQUEST_TEMPLATE='{"model":"{{model}}","prompt":"{{prompt}}","aspect_ratio":"{{aspectRatio}}","duration":"{{duration}}","images":"{{images}}"}'
# SPARKLE_VIDEO_OUTPUT_PATH=url
# SPARKLE_VIDEO_JOB_ID_PATH=id
# SPARKLE_VIDEO_STATUS_PATH=status
# SPARKLE_VIDEO_POLL_ENDPOINT=/videos/{{jobId}}
# SPARKLE_VIDEO_POLL_METHOD=GET
# SPARKLE_VIDEO_POLL_OUTPUT_PATH=url
# SPARKLE_VIDEO_SUCCESS_STATUSES=succeeded,completed,success
# SPARKLE_VIDEO_FAILURE_STATUSES=failed,error,cancelled,canceled
# SPARKLE_VIDEO_AUTH_HEADER=Authorization
# SPARKLE_VIDEO_AUTH_SCHEME=Bearer

# Optional: only needed for Agent runs and text-only skills.
SPARKLE_TEXT_BASE_URL=
SPARKLE_TEXT_API_KEY=
SPARKLE_TEXT_MODEL=

# Keep generated files private to the local workspace and cap paid calls.
SPARKLE_AUTH_MODE=local
SPARKLE_DAILY_API_CALL_LIMIT=100
SPARKLE_ARCHIVE_OUTPUTS=true
SPARKLE_MAX_GENERATED_MEDIA_MB=20
# Set this only when the media provider must fetch local references by URL.
SPARKLE_PUBLIC_URL=
