# Server-only generation configuration. Restart Next after editing .env.local.
# All providers are disabled until their BASE_URL, API_KEY and MODEL are supplied.
# Never prefix these variables with NEXT_PUBLIC_. No legacy/Moyu fallback exists.
# Full contracts, template examples and limits: docs/generation-providers.md.
# BASE_URL includes /v1 if required; relative ENDPOINT appends to that base.
# MODELS is a comma-separated allowlist; MODEL is included automatically.

# Default text protocol: POST /chat/completions, OpenAI JSON messages/model/n.
SPARKLE_TEXT_BASE_URL=
SPARKLE_TEXT_API_KEY=
SPARKLE_TEXT_MODEL=
SPARKLE_TEXT_MODELS=
SPARKLE_TEXT_ENDPOINT=
# Optional JSON object template: '{"model":"{{model}}","messages":"{{messages}}"}'
SPARKLE_TEXT_REQUEST_TEMPLATE=
# Default choices (all message.content candidates); mapped output may also be an array of strings.
SPARKLE_TEXT_OUTPUT_PATH=
# Defaults Authorization and Bearer; scheme 'none' sends the raw key.
SPARKLE_TEXT_AUTH_HEADER=
SPARKLE_TEXT_AUTH_SCHEME=
# Defaults 60000 ms request, 900000 ms job, 20000000 response bytes.
SPARKLE_TEXT_TIMEOUT_MS=
SPARKLE_TEXT_JOB_TIMEOUT_MS=
SPARKLE_TEXT_MAX_RESPONSE_BYTES=

# Default image protocol: POST /images/generations, model/prompt/n/size/image.
SPARKLE_IMAGE_BASE_URL=
SPARKLE_IMAGE_API_KEY=
SPARKLE_IMAGE_MODEL=
SPARKLE_IMAGE_MODELS=
SPARKLE_IMAGE_ENDPOINT=
SPARKLE_IMAGE_REQUEST_TEMPLATE=
# Defaults data (array), url and b64_json (fields relative to each item).
SPARKLE_IMAGE_OUTPUT_PATH=
SPARKLE_IMAGE_URL_PATH=
SPARKLE_IMAGE_B64_PATH=
SPARKLE_IMAGE_AUTH_HEADER=
SPARKLE_IMAGE_AUTH_SCHEME=
SPARKLE_IMAGE_TIMEOUT_MS=
SPARKLE_IMAGE_JOB_TIMEOUT_MS=
SPARKLE_IMAGE_MAX_RESPONSE_BYTES=

# Default video protocol: POST /videos, synchronous URL or asynchronous ID.
SPARKLE_VIDEO_BASE_URL=
SPARKLE_VIDEO_API_KEY=
SPARKLE_VIDEO_MODEL=
SPARKLE_VIDEO_MODELS=
SPARKLE_VIDEO_ENDPOINT=
SPARKLE_VIDEO_REQUEST_TEMPLATE=
# Defaults url, url (relative object field), id, status.
SPARKLE_VIDEO_OUTPUT_PATH=
SPARKLE_VIDEO_URL_PATH=
SPARKLE_VIDEO_JOB_ID_PATH=
SPARKLE_VIDEO_STATUS_PATH=
# Default GET /videos/{{jobId}}. Optional POST JSON template uses {{jobId}}.
SPARKLE_VIDEO_POLL_ENDPOINT=
SPARKLE_VIDEO_POLL_METHOD=
SPARKLE_VIDEO_POLL_REQUEST_TEMPLATE=
# Defaults to OUTPUT_PATH. States are case-insensitive comma-separated labels.
SPARKLE_VIDEO_POLL_OUTPUT_PATH=
SPARKLE_VIDEO_SUCCESS_STATUSES=
SPARKLE_VIDEO_FAILURE_STATUSES=
# Default 3000 milliseconds, bounded 100-60000.
SPARKLE_VIDEO_POLL_INTERVAL_MS=
SPARKLE_VIDEO_AUTH_HEADER=
SPARKLE_VIDEO_AUTH_SCHEME=
SPARKLE_VIDEO_TIMEOUT_MS=
SPARKLE_VIDEO_JOB_TIMEOUT_MS=
SPARKLE_VIDEO_MAX_RESPONSE_BYTES=

# Optional public app origin. Blank converts local media <=20 MiB into data URLs.
# Nonblank converts local references to public URLs, required for larger videos.
SPARKLE_PUBLIC_URL=

# Persistent local backend. Blank paths use database.sqlite and data/uploads.
SPARKLE_DATABASE_PATH=
SPARKLE_MEDIA_PATH=
# local binds loopback; accounts requires authenticated access.
SPARKLE_AUTH_MODE=local
SPARKLE_ALLOW_REGISTRATION=false
SPARKLE_API_REQUESTS_PER_MINUTE=600
SPARKLE_DAILY_API_CALL_LIMIT=100
# Optional stable random secret of at least 32 characters; otherwise a private key file is created.
SPARKLE_MEDIA_SIGNING_KEY=
SPARKLE_ARCHIVE_OUTPUTS=true
SPARKLE_MAX_GENERATED_MEDIA_MB=20
SPARKLE_FFMPEG_PATH=ffmpeg
SPARKLE_FFPROBE_PATH=ffprobe
# Optional native video mode for the selected text provider.
SPARKLE_TEXT_VIDEO_MODE=

# Normalized HTTPS payment gateway; requires a vendor adapter, not a native vendor endpoint.
# Contract and reconciliation: docs/backend-readiness.md
SPARKLE_PAYMENT_BASE_URL=
SPARKLE_PAYMENT_API_KEY=
SPARKLE_PAYMENT_WEBHOOK_SECRET=
